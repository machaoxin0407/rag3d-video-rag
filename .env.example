# Copy this file to .env and fill values locally. Never commit .env.

# API authentication
KAFU_API_TOKEN=replace-with-random-token

# service / tech classifier
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=replace-with-provider-key
DEEPSEEK_BINARY_MODEL=deepseek-v4-flash

# main answer model (OpenAI-compatible)
SILICONFLOW_BASE_URL=https://your-openai-compatible-endpoint.example/v1
SILICONFLOW_API_KEY=replace-with-provider-key
SILICONFLOW_MODEL=replace-with-model-name

# retrieval
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=replace-with-provider-key
EMBEDDING_MODEL=Pro/BAAI/bge-m3
RERANK_BASE_URL=https://api.siliconflow.cn/v1
RERANK_API_KEY=replace-with-provider-key
RERANK_MODEL_ALIAS=BAAI/bge-reranker-v2-m3

# local video-scene retrieval
# Start with: ./video_embedding_service.sh start
VIDEO_RETRIEVAL_MODE=tri_hybrid
VIDEO_RUNTIME_PROFILE=production
# Production: fail a technical request instead of silently using fewer modalities.
VIDEO_REQUIRE_EXACT_MODE=1
VIDEO_MIN_CONTENT_BM25=2.0
VIDEO_DENSE_ENDPOINT=http://127.0.0.1:8091
VIDEO_DENSE_TIMEOUT_S=1.5
VIDEO_EMBEDDING_DEVICE=cuda:0
VIDEO_EMBEDDING_PORT=8091

# optional direct-video Qwen3-VL retrieval service
VIDEO_VISUAL_DENSE_ENDPOINT=http://127.0.0.1:8092
VIDEO_VISUAL_DENSE_TIMEOUT_S=2.0
VIDEO_VISUAL_CUDA_VISIBLE_DEVICES=1
VIDEO_VISUAL_EMBEDDING_PORT=8092

# asynchronous user-video diagnosis
USER_VIDEO_MAX_BYTES=209715200
USER_VIDEO_MAX_DURATION_S=60
USER_VIDEO_MAX_PIXELS=8294400
USER_VIDEO_ASYNC_MODE=spool
# OpenAI-compatible multimodal endpoint; leave empty for explicit insufficient_evidence.
USER_VIDEO_VLM_BASE_URL=
USER_VIDEO_VLM_API_KEY=
USER_VIDEO_VLM_MODEL=

# runtime
CHAT_TIMEOUT_S=50
CHAT_MULTIMODAL_TIMEOUT_S=60
CHAT_MAX_IMAGES=3
RERANK_ENABLED=1
RETURN_PARENT_SECTION=1
